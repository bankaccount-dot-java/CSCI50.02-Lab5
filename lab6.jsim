.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* The fa and add32 subcircuits are copied from lab3.jsim. 
* The fa subcircuit is a full-adder that takes three single-bit inputs (a, b, 
*   and c_in) and produces a single-bit sum and carry_out.
* The add32 subcircuit is a 32-bit ripple-carry adder that uses 32 instances of
*   the fa subcircuit to add two 32-bit numbers along with an initial carry-in.
*******************************************************************************

.subckt fa a b c_in sum c_out
    Xxor1 a b axorb xor2
    Xxor2 axorb c_in sum xor2
    Xnand1 a b term1 nand2
    Xnand2 c_in axorb term2 nand2
    Xnand3 term1 term2 c_out nand2
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
  Xbit a[31:0] b[31:0] cout[30:0] cin0 sum[31:0] cout[31:0] fa
.ends

*******************************************************************************
* The as32 subcircuit instantiates a 32-bit adder and a 32-bit multiplexer 
* to perform addition or subtraction depending on the selected operation.
*******************************************************************************

.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
    *INVERT B
    Xinv b[31:0] b_inv[31:0] inverter

    *MULTIPLEXER
    Xmux b[31:0] b_inv[31:0] op0#32 b_mux[31:0] mux2
    * ^^ revisions by Phoebe: added #32 to op0

    *INSTANTIATE ADD32
    Xadd32 a[31:0] b_mux[31:0] op0 fas[31:0] c31 c30 add32

    *NEGATIVE FLAG
    .connect fas[31] n

    *OVERFLOW FLAG
    Xxor1 c31 c30 v xor2

    *ZERO FLAG
    * 1. Check 32 bits (8 x 4-input or)
    * 2. Check reduced 8 bits (2 x 4-input or)
    * 3. Check reduced 2 bits WITH INVERT (1 x 2-input nor) 

    Xor1 fas[31:28] z1[0] or4
    Xor2 fas[27:24] z1[1] or4
    Xor3 fas[23:20] z1[2] or4
    Xor4 fas[19:16] z1[3] or4
    Xor5 fas[15:12] z1[4] or4
    Xor6 fas[11:8]  z1[5] or4
    Xor7 fas[7:4]   z1[6] or4
    Xor8 fas[3:0]   z1[7] or4

    Xor9 z1[3:0]  z2[0] or4
    Xor10 z1[7:4] z2[1] or4

    Xnor1 z2[1:0] z nor2
.ends

*******************************************************************************
* The cmp32 subcircuit creates a 32-bit comparator that compares two 32-bit numbers
* using the negative, overflow, and zero flags from the adder/subtractor subcircuit.
* When op[1] = 1, the comparator checks for equality using the zero flag.
* When op[2] = 1, it checks for less than using the negative and overflow flags.
* When both op[1] and op[2] are 0, it checks for less than or equal using all three flags.
* The output fcmp[0] is set to 1 if any of the selected conditions are met, and 0 otherwise.
*
* By de morgan's law, (op[1] and z) or (op[2] and (n xor v)) is equivalent to 
* (op[1] nand z) nand (op[2] nand (n xor v))).
*******************************************************************************

.subckt cmp32 n v z op[2:1] fcmp[31:0]
    Xnoteq op[1] z noteq nand2
    Xxor n v nxorv xor2
    Xnotlt op[2] nxorv notlt nand2
    Xout noteq notlt fcmp[0] nand2
    .connect 0 fcmp[31:1]
.ends

********************************************************************************
* bool32 subcircuit
*********************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
    Xbool a[31:0] b[31:0] op[0]#32 op[1]#32 op[2]#32 op[3]#32 fbool[31:0] mux4
.ends

********************************************************************************
* shift32 subcircuit
*********************************************************************************

* Helper function that reverses the bits based on the value of op
.subckt reverse op torev[31:0] out[31:0]
    * If op is 0 (Shift Left is 00), output torev[0:31] (reversed)   
    * Else (Logical and Arithmetic Shift Right, 01 and 11), output torev[31:0] (itself)
    Xin op#32 torev[0:31] torev[31:0] out[31:0] mux2
.ends

.subckt shift32 a[31:0] b[4:0] op[1:0] fshift[31:0]
    * Performs an AND operation with op[1] and MSB of A to decide what to use as
    * use as filler after shifting
    Xfill op[1] a[31] fill and2

    * If Shift Right (Arithmetic and Logical), input is itself,
    * If Shift Left, the input to be shifted is reversed
    Xin op[0] a[31:0] toshift[31:0] reverse

    * SHIFTING
    * 5th bit mux; shift by 16
    Xbit5 b[4]#32 toshift[31:0] fill#16 toshift[31:16] shift16[31:0] mux2

    * 4th bit mux; shift by 8
    Xbit4 b[3]#32 shift16[31:0] fill#8 shift16[31:8] shift8[31:0] mux2

    * 3rd bit mux; shift by 4
    Xbit3 b[2]#32 shift8[31:0] fill#4 shift8[31:4] shift4[31:0] mux2

    * 2nd bit mux; shift by 2
    Xbit2 b[1]#32 shift4[31:0] fill#2 shift4[31:2] shift2[31:0] mux2

    * 1st bit mux; shift by 1
    Xbit1 b[0]#32 shift2[31:0] fill#1 shift2[31:1] shiftdone[31:0] mux2
    
    * If Shift Left, it reverses the bits once again
    * If Shift Right (Arithmetic and Logical), the output is retained
    Xout op[0] shiftdone[31:0] fshift[31:0] reverse

.ends


********************************************************************************
* The alu32 subcircuit instantiates four subcircuits that compute their respective 
* outputs in parallel. The mux4 then selects which output becomes the final result
* based on alufn[5:4]. If alufn[5:4] is 00, fas from as32 is selected. If it is 01,
* fbool from bool32 is selected. If it is 10, fshift from shift32 is selected. If 
* it is 11, fcmp from cmp32 is selected.
*********************************************************************************
.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0]
    * as32
    Xas32 a[31:0] b[31:0] alufn[0] fas[31:0] n v z as32

    * bool32
    Xbool32 a[31:0] b[31:0] alufn[3:0] fbool[31:0] bool32

    * shift32
    Xshift32 a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32

    * cmp32 (chained with as32)
    Xcmp32 n v z alufn[2:1] fcmp[31:0] cmp32

    * final output using mux4
    Xmux alufn[4]#32 alufn[5]#32 fas[31:0] fbool[31:0] fshift[31:0] fcmp[31:0] f[31:0] mux4
    *  ^^ revisions by Phoebe: added #32 to alufn[4] and alufn[5]
.ends

********************************************************************************
* INSTANTIATE ADDER/SUBTRACTOR AND COMPARATOR SUBCIRCUITS
*********************************************************************************

Xalu32 a[31:0] b[31:0] alufn[5:0] f[31:0] alu32

Wa a[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ -1 0x55555555 0xAAAAAAAA 1 -2 -1 -1 0x55555555 0 -1 0x55555555 0
+ -1 0x55555555 0 -1 0x55555555 0 -1 0x55555555 0 1 -1 -1 0x55555555 0xAAAAAAAA -1
+ 0x55555555 0xAAAAAAAA -1 -1 15 0 -1 15 0 -1 15 0

Wb b[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ 1 0x55555555 0xAAAAAAAA 1 0 -1 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0
+ -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 31 15 0 24 24 31
+ 24 24 31 1 15 -256 1 15 -256 1 15 -256

Wf alufn[5:0] nrz(0v,5.0v,60ns,0ns,.1ns,.1ns)
+ 0 1 24 30 22 26 21 32 33 35 51 53 55

* Explanation of Test Cases:
* 1. a = -1, b = 1, alufn = 000000 --> use as32, add 0 and 0
* 2. a = 0x55555555, b = 0x55555555, alufn = 011000 (24) --> use bool32, 

********************************************************************************
* NODE PLOTTING:
********************************************************************************
.tran 800ns
.plot a[31:0]
.plot b[31:0]
.plot alufn[5:0]
.plot f[31:0]